---
import Icon from './Icon.astro';
import Marquee from './Marquee.astro';
import { CONTACTS } from '../config';
import { getProjects } from '../lib/projects';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const [l1, l2, l3] = d.hero.lines;
// The featured project's measured facts go right under the calls to action: the claim gets its proof.
const featured = (await getProjects(lang)).find((p) => p.featured && p.highlights.length);
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <canvas class="hero-cv"></canvas>
    <div class="hero-fade"></div>
  </div>
  <div class="wrap hero-in">
    {/* Parts never break inside; on a phone the line wraps only at a "·". */}
    <div class="eyebrow mono rise"><span>{d.hero.eyebrow.split(' · ').map((part, i) => <>{i > 0 && ' · '}<span class="nw">{part}</span></>)}</span></div>
    <h1 class="h1" id="hero-title">
      <span class="rise d1">{l1}</span>
      <span class="rise d2">{l2}</span>
      <span class="rise d3"><span class="grad">{l3}</span></span>
    </h1>
    <p class="lead rise d4">{d.hero.lead}</p>
    <div class="cta-row rise d5">
      <a class="btn btn-p" href="#projects" data-magnet>{d.hero.primary} <Icon name="arrow" size={18} class="arr" /></a>
      <a class="btn btn-g" href={CONTACTS.telegram} target="_blank" rel="noopener" data-magnet>{d.discuss} <Icon name="arrow-ur" size={15} class="arr-ur arr" /></a>
    </div>
    {featured && (
      <div class="proof mono rise d6" role="group" aria-label={d.hero.proofLabel}>
        <ul>
          <li class="proof-k">{featured.short ?? featured.title}</li>
          {featured.highlights.map((h) => <li><b>{h.value}</b> {h.label}</li>)}
        </ul>
        <ul>
          {featured.links.demo && <li><a href={featured.links.demo} target="_blank" rel="noopener">{d.hero.proofDemo} <Icon name="arrow-ur" size={12} /></a></li>}
          {featured.links.github && <li><a href={featured.links.github} target="_blank" rel="noopener">{d.hero.proofCode} <Icon name="arrow-ur" size={12} /></a></li>}
        </ul>
      </div>
    )}
    <p class="open rise d6"><i aria-hidden="true"></i>{d.hero.open}</p>
  </div>
  <Marquee lang={lang} />
</section>

<script>
  import '../scripts/hero-scene';
</script>
