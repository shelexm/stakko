---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { CONTACTS } from '../../config';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).work;
const mail = `mailto:${CONTACTS.email}?subject=${encodeURIComponent(d.empSubject)}`;
---
<section class="sec line" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead num="05" kicker={d.kicker} title={d.title} titleId="work-title" sub={d.sub} />
    <div class="paths">
      <div class="path path-emp reveal">
        <div>
          <div class="plbl mono">{d.empLabel}</div>
          <p class="pbig">{d.empText}</p>
        </div>
        <div class="pact">
          <a class="btn btn-g" href={mail}>{d.empCta} <Icon name="arrow" class="arr" /></a>
          <a class="btn btn-g" href={CONTACTS.github} target="_blank" rel="noopener">{t(lang).projects.codeOnGithub} <Icon name="arrow-ur" size={15} class="arr-ur arr" /></a>
        </div>
      </div>
      <div class="path path-cli reveal s1">
        <div>
          <div class="plbl mono">{d.cliLabel}</div>
          <p class="pbig">{d.cliText}</p>
        </div>
        <div class="pact">
          <a class="btn btn-p" href={CONTACTS.telegram} target="_blank" rel="noopener">{t(lang).discuss} <Icon name="arrow" class="arr" /></a>
        </div>
      </div>
    </div>
  </div>
</section>
