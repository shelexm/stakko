---
interface Props {
  href: string;
  label: string;
  small?: boolean;
}

const { href, label, small = false } = Astro.props;
---
<a class="logo" href={href} aria-label={label}>
  <svg width={small ? 22 : 26} height={small ? 19 : 22} viewBox="0 0 26 22" aria-hidden="true">
    <rect x="0" y="0" width="18" height="5" rx="2.5" fill="#5B9DFF" />
    <rect x="4" y="8.5" width="18" height="5" rx="2.5" fill="#8F7BFF" />
    <rect x="8" y="17" width="18" height="5" rx="2.5" fill="#45D6FF" />
  </svg>
  <span>STAKKO</span>
</a>
