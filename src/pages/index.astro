---
// Root: send the visitor to /ru/ or /en/. A saved manual choice wins, then the browser languages.
import { SITE_URL } from '../config';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>STAKKO · Full-stack Developer</title>
  <meta name="description" content="Портфолио full-stack разработчика. Full-stack developer portfolio." />
  <link rel="alternate" hreflang="ru" href={`${SITE_URL}/ru/`} />
  <link rel="alternate" hreflang="en" href={`${SITE_URL}/en/`} />
  <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#070B16" />
  <script is:inline>
    (function () {
      var lang = null;
      try {
        var saved = localStorage.getItem('stakko-lang');
        if (saved === 'ru' || saved === 'en') lang = saved;
      } catch (e) {}
      if (!lang) {
        var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        lang = 'en';
        for (var i = 0; i < list.length; i++) {
          var code = String(list[i]).toLowerCase();
          if (code.indexOf('ru') === 0) { lang = 'ru'; break; }
          if (code.indexOf('en') === 0) break;
        }
      }
      location.replace('/' + lang + '/' + location.hash);
    })();
  </script>
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #070B16; color: #F1F5FF; font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; }
    nav { display: flex; gap: 12px; }
    a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 14px; border: 1px solid rgba(140,165,255,.18); color: #F1F5FF; text-decoration: none; font-weight: 600; }
    a:hover { background: rgba(140,165,255,.10); }
    a:focus-visible { outline: 2px solid #8DB6FF; outline-offset: 3px; }
  </style>
</head>
<body>
  <nav aria-label="Язык / Language">
    <a href="/ru/" lang="ru" hreflang="ru">Русский</a>
    <a href="/en/" lang="en" hreflang="en">English</a>
  </nav>
</body>
</html>
